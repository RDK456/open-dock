{
  "expo": {
    "name": "Open Dock",
    "slug": "open-dock-phone",
    "scheme": "opendock",
    "version": "1.6.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "backgroundColor": "#09090b",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.opendock.phone",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Open Dock connects to your PC on the same Wi-Fi network to send the controls you choose.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.opendock.phone",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 10602,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#09090b"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Open Dock to scan the PC pairing code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#09090b",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-speech-recognition"
    ]
  }
}
